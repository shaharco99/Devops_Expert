properties([
    githubProjectProperty(displayName: '', projectUrlStr: 'https://github.com/shaharco99/Devops_Expert.git'),
    // githubPush() alone needs GitHub to reach this Jenkins over a public
    // webhook URL - doesn't work for a local/minikube instance behind a
    // port-forward with no public address. pollSCM covers that case (checks
    // GitHub every minute regardless of inbound reachability); keep
    // githubPush() too so a real webhook (once one's reachable) triggers
    // instantly instead of waiting up to a minute.
    pipelineTriggers([
        githubPush(),
        pollSCM('* * * * *')
    ])
])

pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: docker
                    image: shaharco1804/world_of_game
                    command:
                    - cat
                    tty: true
                    volumeMounts:
                     - mountPath: /var/run/docker.sock
                       name: docker-sock
                  volumes:
                  - name: docker-sock
                    hostPath:
                      path: /var/run/docker.sock
            '''
        }
    }

    environment {
        DOCKER_HUB_REPO = "shaharco1804/score_flask"
        CONTAINER_NAME = "score_flask"
        imageVersion = "v${new Date().format('YYYYMMdd')}"
        WORKSPACE_DIR = "WorldOfGames"
    }

    stages {
        stage('Workspace Inspection') {
            steps {
                container('docker') {
                    sh '''
                        echo "=== Workspace Content ==="
                        ls -la ${WORKSPACE_DIR}
                        echo "=== Requirements File Check ==="
                        if [ -f "${WORKSPACE_DIR}/requirements" ]; then
                            echo "Requirements file exists"
                            cat ${WORKSPACE_DIR}/requirements
                        else
                            echo "ERROR: requirements file is missing!"
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('Secrets Scan') {
            steps {
                container('docker') {
                    sh '''
                        echo "=== Scanning for leaked secrets ==="
                        git config --global --add safe.directory "$(pwd)"
                        gitleaks detect --source . -v
                    '''
                }
            }
        }

        stage('Lint') {
            steps {
                container('docker') {
                    sh '''
                        cd ${WORKSPACE_DIR}
                        echo "=== Linting Python source ==="
                        ruff check .
                    '''
                }
            }
        }

        stage('Format Check') {
            steps {
                container('docker') {
                    sh '''
                        cd ${WORKSPACE_DIR}
                        echo "=== Checking formatting ==="
                        black --check .
                    '''
                }
            }
        }

        stage('Dependency Audit') {
            steps {
                container('docker') {
                    sh '''
                        cd ${WORKSPACE_DIR}
                        echo "=== Auditing dependencies for known CVEs ==="
                        pip-audit -r requirements
                    '''
                }
            }
        }

        stage('Clean') {
            steps {
                container('docker') {
                    sh '''
                        echo "=== Cleaning up containers ==="
                        docker rm -f ${CONTAINER_NAME} || echo "No container ${CONTAINER_NAME} to remove"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                container('docker') {
                    sh '''
                        echo "=== Building Docker Image ==="
                        docker build -t ${DOCKER_HUB_REPO}:${imageVersion} --pull WorldOfGames/. --no-cache
                        echo "=== Image Details ==="
                        docker images | grep ${DOCKER_HUB_REPO}
                    '''
                }
            }
        }

        stage('Image Scan') {
            steps {
                container('docker') {
                    // Report-only, not gating: python:alpine's own bundled pip
                    // ships vendored deps (e.g. pip._vendor.msgpack) that Trivy
                    // flags as HIGH/fixed even though there's no real standalone
                    // version to bump from our side (verified: pip install
                    // --upgrade pip already gives the latest available and
                    // still trips this). A hard --exit-code gate here would
                    // permanently block builds on something we can't fix.
                    // Revisit if/when upstream resolves it.
                    sh '''
                        echo "=== Scanning image for known CVEs (report-only) ==="
                        trivy image --severity HIGH,CRITICAL --ignore-unfixed ${DOCKER_HUB_REPO}:${imageVersion}
                    '''
                }
            }
        }

        stage('Run') {
            steps {
                container('docker') {
                    sh '''
                        cd ${WORKSPACE_DIR}
                        echo "=== Starting Services ==="
                        docker-compose down --remove-orphans
                        docker-compose up -d --build
                        echo "=== Service Logs ==="
                        docker-compose logs score
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                container('docker') {
                    sh '''
                        cd ${WORKSPACE_DIR}
                        echo "=== Running Tests ==="
                        echo "=== Test Environment Setup ==="
                        echo "Current directory: $(pwd)"
                        ls -la
                        echo "=== Running Tests ==="
                        docker-compose run --rm tester
                        echo "=== Test Logs ==="
                        docker-compose logs tester
                    '''
                }
            }
        }

        stage('Finalize') {
            steps {
                container('docker') {
                    withDockerRegistry([ credentialsId: "dockerhub", url: "" ]) {
                        sh '''
                            echo "=== Pushing Image to Registry ==="
                            docker push ${DOCKER_HUB_REPO}:${imageVersion}
                            echo "=== Cleanup ==="
                            cd ${WORKSPACE_DIR}
                            docker-compose down --remove-orphans
                        '''
                    }
                }
            }
        }

        // Deploy step: bump the image tag in the manifest repo and push.
        // ArgoCD (watching this path with automated sync) picks up the
        // commit and applies it to the cluster - Jenkins no longer runs
        // docker-compose against a live "prod" target.
        stage('Deploy (bump manifest)') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                        sh '''
                            cd ${WORKSPACE_DIR}
                            sed -i "s|image: ${DOCKER_HUB_REPO}:.*|image: ${DOCKER_HUB_REPO}:${imageVersion}|" manifests/score-flask.yaml
                            git config user.email "jenkins@ci"
                            git config user.name "jenkins"
                            git add manifests/score-flask.yaml
                            if ! git diff --cached --quiet; then
                                git commit -m "deploy: bump score-flask image to ${imageVersion}"
                                git push https://${GIT_USER}:${GIT_TOKEN}@github.com/shaharco99/Devops_Expert.git HEAD:main
                            else
                                echo "No image tag change to push"
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            container('docker') {
                sh '''
                    cd ${WORKSPACE_DIR}
                    echo "=== Cleanup ==="
                    docker-compose down --remove-orphans
                '''
            }
        }
        failure {
            container('docker') {
                sh '''
                    cd ${WORKSPACE_DIR}
                    echo "=== Debug Information on Failure ==="
                    echo "Docker Compose Logs:"
                    docker-compose logs
                    echo "Docker Container Status:"
                    docker ps -a
                    echo "Workspace Contents:"
                    ls -la
                '''
            }
        }
    }
}